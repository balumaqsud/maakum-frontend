# Server-only. The browser never calls the API.
# Point this at the API for the environment you are running. Do not use a production host here.
API_URL=http://localhost:4000/api/v1

# Public site origin for canonical URLs, the sitemap, and share previews.
# Set this to the production origin when deploying. Do not use a placeholder host.
SITE_URL=http://localhost:3000
